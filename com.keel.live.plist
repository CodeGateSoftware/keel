    <!-- Run on load, so a boot that lands between triggers catches the UTC day up immediately
         instead of waiting up to an hour. The runner's day-stamp makes a repeated load
         harmless. -->
    <key>RunAtLoad</key>
    <true/>

    <key>WorkingDirectory</key>
